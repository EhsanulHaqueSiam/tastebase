# Cloudflare static-asset headers. Screenshots, marks and sponsor logos keep their names when recaptured, so they get a
# day of fresh cache and a week of stale-while-revalidate instead of the default revalidate-on-every-load.
/shots/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/marks/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/sponsors/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
# Rebuilt with each deploy; an hour of browser cache keeps tab switches instant without serving a stale list long.
/atlas-rows
  Cache-Control: public, max-age=3600
# Fonts never change under the same name (a new cut gets a new file name).
/_fonts/*
  Cache-Control: public, max-age=31536000, immutable
