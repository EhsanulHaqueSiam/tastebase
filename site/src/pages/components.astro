---
// /components: the component index grouped by name. The page carries the groups it shows (without search terms);
// the island fetches the rest from /components.json when search is first used. Every group's props rode along on
// each visit before (~440 KB of HTML), parsed on every tab switch.
import Components, { SHOWN } from "../components/Components.tsx";
import Base from "../layouts/Base.astro";
import { components } from "../../../src/registry/components.ts";
import { componentGroups } from "../lib/component-groups.ts";

export const prerender = true;

const groups = componentGroups();
const libCount = Object.keys(components).length;
---

<Base title="Components · tastebase" description={`${groups.length} UI components across ${libCount} libraries, each linked to its docs.`}>
  <Components
    client:load
    first={groups.slice(0, SHOWN).map(({ terms: _, ...g }) => g)}
    groupCount={groups.length}
    parts={groups.reduce((n, g) => n + g.libs.length, 0)}
    libCount={libCount}
  />
</Base>
