    /* reference: developer docs */
    .qref { display: grid; grid-template-columns: 27cqw 1fr; grid-template-rows: 9cqw 1fr; font: 400 3.2cqw/1.4 var(--font-sans); letter-spacing: 0; }
    .qref .tp { grid-column: span 2; display: flex; align-items: center; gap: 3cqw; padding: 0 3.6cqw; border-bottom: 1px solid #d0d7de; }
    .qref .tp b { display: flex; align-items: center; gap: 1.4cqw; font-size: 3.8cqw; font-weight: 600; }
    .qref .tp b i { width: 3.4cqw; height: 3.4cqw; border-radius: .9cqw; }
    .qref .srch { display: flex; align-items: center; justify-content: space-between; width: 34cqw; margin-left: 6cqw; padding: 1.2cqw 1.6cqw; border: 1px solid #d0d7de; border-radius: 1.2cqw; color: #6e7781; }
    .qref kbd { font: 500 2.6cqw var(--font-mono); padding: .2cqw 1cqw; border-radius: .6cqw; background: #eaeef2; color: #57606a; }
    .qref .ver { padding: 1.2cqw 2cqw; border: 1px solid #d0d7de; border-radius: 1.2cqw; font: 500 2.9cqw var(--font-mono); white-space: nowrap; }
    .qref .nv { display: grid; align-content: start; gap: .2cqw; padding: 2.6cqw 1.4cqw; overflow: hidden; border-right: 1px solid #d0d7de; font-size: 3cqw; color: #57606a; }
    .qref .nv span { padding: .7cqw 1.6cqw; white-space: nowrap; }
    .qref .nv .gh { margin-top: 1.4cqw; font-size: 2.5cqw; font-weight: 600; color: #1f2328; text-transform: uppercase; letter-spacing: .04em; }
    .qref .nv .gh:first-child { margin-top: 0; }
    .qref .nv .on { font-weight: 600; }
    .qref .nv .mono { font: 400 3cqw var(--font-mono); }
