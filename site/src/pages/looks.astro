    /* Specimens for the family roots and the rest (r6). Roots are z-prefixed to stay clear of page class names. */
    :is(.zgp, .zap, .zio, .zpl, .zne, .zlx, .zql, .zmg, .zgg, .zsp, .zsc, .zlf, .zct, .zfl, .zmd, .zhc, .zft, .zy2, .zpx, .zdt, .zgr, .zcl, .zsb, .zac, .zgm) { position: absolute; inset: 0; overflow: hidden; letter-spacing: 0; }
    :is(.zgp, .zap, .zio, .zpl, .zne, .zlx, .zql, .zmg, .zgg, .zsp, .zsc, .zlf, .zct, .zfl, .zmd, .zhc, .zft, .zy2, .zpx, .zdt, .zgr, .zcl, .zsb, .zac, .zgm) :is(i, em, b, span, kbd) { font-style: normal; }
    :is(.zgp, .zap, .zio, .zpl, .zne, .zlx, .zql, .zmg, .zgg, .zsp, .zsc, .zlf, .zct, .zfl, .zmd, .zhc, .zft, .zy2, .zpx, .zdt, .zgr, .zcl, .zsb, .zac, .zgm) svg { display: block; }

