    .qref .t em { margin-left: 1.6cqw; font-style: normal; font-weight: 400; opacity: .7; }
    .qref p { max-width: 58cqw; color: #424a53; }
    .qref .cb { width: 60cqw; border-radius: 1.6cqw; overflow: hidden; background: #0d1117; color: #e6edf3; }
    .qref .cb .tabz { display: flex; gap: 3cqw; padding: 1.4cqw 2.6cqw; border-bottom: 1px solid #30363d; font-size: 2.9cqw; color: #8b949e; }
    .qref .cb .tabz .on { color: #e6edf3; box-shadow: 0 1.5cqw 0 -1.1cqw #e6edf3; }
    .qref .cb .tabz em { margin-left: auto; font-style: normal; }
    .qref .cb code { display: block; padding: 2.4cqw 2.6cqw; font: 400 3cqw var(--font-mono); white-space: nowrap; }
    .qref .note { width: 60cqw; padding: 1.6cqw 2.4cqw; border-left: .6cqw solid; border-radius: 1cqw; }

    /* homepage: web 1.0 */
    .qhom { background: radial-gradient(1.2px 1.2px at 12% 18%, #fff 50%, transparent), radial-gradient(1px 1px at 72% 8%, #fff 50%, transparent), radial-gradient(1px 1px at 40% 70%, #ffffaa 50%, transparent), radial-gradient(1.2px 1.2px at 88% 52%, #fff 50%, transparent); background-size: 16cqw 14cqw; }
    .qhom .page { position: absolute; left: 9cqw; right: 9cqw; top: 4cqw; display: grid; justify-items: center; gap: 2cqw; padding: 3.4cqw 3cqw 5cqw; text-align: center; font: 400 3.6cqw/1.25 "Times New Roman", Times, serif; color: #000; }
    .qhom .h { font: 700 7cqw/1.05 "Times New Roman", Times, serif; color: #cc0000; }
    .qhom .rb { width: 100%; height: 1cqw; background: linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f); }
    .qhom .uc { padding: .6cqw 3cqw; border: .9cqw solid; border-image: repeating-linear-gradient(-45deg, #000 0 1cqw, #ffdd00 1cqw 2cqw) 9; font: 700 3.2cqw Arial, sans-serif; text-transform: uppercase; color: #000; background: #ffdd00; }
    .qhom .hits { display: flex; align-items: center; gap: 1.6cqw; font-size: 3.4cqw; }
    .qhom .hits b { display: flex; gap: .3cqw; }
    .qhom .hits i { padding: .2cqw .8cqw; background: #000; color: #33ff33; font: 700 3.4cqw "Courier New", monospace; font-style: normal; }
    .qhom .bt { display: flex; gap: 1.6cqw; }
    .qhom .bt i { width: 15cqw; height: 5.3cqw; display: grid; place-items: center; font: 700 2.4cqw Verdana, Arial, sans-serif; font-style: normal; background: #c0c0c0; color: #000; box-shadow: inset .4cqw .4cqw 0 #fff, inset -.4cqw -.4cqw 0 #808080; }
    .qhom .bt .b2 { background: #000080; color: #ffff00; }
    .qhom .bt .b3 { background: #008080; color: #fff; }
    /* Chrome text only where background-clip:text works (else solid text, never a gradient box); opaque panes where backdrop-filter is missing. */
    @supports (background-clip: text) or (-webkit-background-clip: text) {
      .zy2 .ch { color: transparent; background-image: var(--chrome); -webkit-background-clip: text; background-clip: text; }
      .zac .cw { color: transparent; background-image: linear-gradient(180deg, #fff 0, #c9cdd2 30%, #3a3f45 50%, #f2f2f2 58%, #8b9198 80%, #fff); -webkit-background-clip: text; background-clip: text; }
    }
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      .zgp .pn { background: var(--fb); }
      .zfl .acr { background: rgb(250 250 250 / .96); }
    }

    /* Detail panel: right side on desktop, full sheet on phones. Below the header: <main>'s view transition traps z-index. */
    .panel { position: fixed; z-index: 30; inset: 56px 0 0 auto; width: min(440px, 100%); overflow-y: auto; overscroll-behavior: contain; background: #050505; box-shadow: -1px 0 0 var(--color-line2); visibility: hidden; transform: translateX(100%); transition: transform 200ms var(--ease-out), visibility 0s 200ms; }
    .panel[data-open] { visibility: visible; transform: none; transition: transform 240ms var(--ease-out); }
    .panel > .spec { aspect-ratio: 16 / 10; }
    .pbody { display: grid; gap: 18px; padding: 16px 18px 120px; font-size: 13px; }
    .ptop { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
    .ptop h2 { font-size: 20px; font-weight: 600; letter-spacing: -0.02em; }
    .ptop p { font-size: 12.5px; color: var(--color-fg3); }
    .ptop p a { color: var(--color-fg2); text-decoration: underline; text-decoration-color: var(--color-line2); text-underline-offset: 3px; }
    .x { flex: none; display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; color: var(--color-fg2); background: var(--color-s2); transition: color 160ms, transform 160ms var(--ease-out); }
    .x:hover { color: var(--color-fg); }
    .x:active { transform: scale(0.94); }
    .sum { font-size: 14px; color: var(--color-fg2); }
    .vs { padding-left: 10px; border-left: 2px solid var(--color-blue); }
    .rules, .picks { display: grid; grid-template-columns: 64px 1fr; gap: 8px 12px; }
    .rules dt, .picks dt { color: var(--color-fg3); }
    .picks { grid-template-columns: 104px 1fr; gap: 6px 12px; }
    .picks dd, .refs { display: flex; flex-wrap: wrap; gap: 4px 10px; }
    .pbody h3 { margin-bottom: 6px; font-size: 12px; font-weight: 400; color: var(--color-fg3); }
    .sig { font: 12px/1.6 var(--font-mono); color: var(--color-fg2); }
    a.lib { text-decoration: underline; text-decoration-color: var(--color-line2); text-underline-offset: 3px; transition: text-decoration-color 160ms; }
    a.lib:hover { text-decoration-color: var(--color-fg); }
    .acts { display: flex; flex-wrap: wrap; gap: 8px; }
    .btn { height: 32px; padding: 0 12px; border-radius: 8px; font-size: 13px; font-weight: 500; white-space: nowrap; color: #000; background: var(--color-fg); transition: transform 160ms var(--ease-out), opacity 160ms; }
    .btn:active { transform: scale(0.97); }
    .btn:disabled { opacity: 0.4; cursor: default; transform: none; }
    .btn.ghost { color: var(--color-fg); background: var(--color-s2); }

    /* Compare tray and view */
    .tray { position: fixed; z-index: 20; left: 50%; bottom: 16px; display: flex; align-items: center; gap: 10px; max-width: calc(100% - 32px); padding: 6px 6px 6px 8px; border-radius: 12px; background: #0b0b0c; box-shadow: 0 0 0 1px var(--color-line2), 0 20px 50px rgb(0 0 0 / 0.7); visibility: hidden; transform: translate(-50%, 140%); transition: transform 200ms var(--ease-out), visibility 0s 200ms; }
    .tray[data-open] { visibility: visible; transform: translate(-50%, 0); transition: transform 220ms var(--ease-out); }
    .mini { display: flex; gap: 6px; }
    .mini button { width: 34px; height: 26px; overflow: hidden; border-radius: 6px; box-shadow: 0 0 0 1px var(--color-line2); transition: transform 160ms var(--ease-out); }
    .mini button:active { transform: scale(0.94); }
    .hint { font-size: 12.5px; white-space: nowrap; color: var(--color-fg2); }

    /* No fade on open: an opacity transition here makes Chrome drop backdrop-filter in glass specimens. */
    .cmp { position: fixed; inset: 0; width: 100%; max-width: none; height: 100%; max-height: none; margin: 0; padding: 0; overflow: auto; overscroll-behavior: contain; border: 0; color: var(--color-fg); background: #000; }
    .cmp::backdrop { background: #000; }
    .cmp-head { position: sticky; top: 0; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 14px 16px; border-bottom: 1px solid var(--color-line); background: #000; }
    .cmp-head h2 { font-size: 14px; font-weight: 600; }
    .cols { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, 1fr); grid-template-rows: repeat(8, auto); gap: 0 16px; padding: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; }
    .col { display: grid; grid-row: span 8; grid-template-rows: subgrid; scroll-snap-align: start; }
    .col > * { padding: 12px 0; border-bottom: 1px solid var(--color-line); font-size: 13px; }
    /* Same shape as the panel: shorter crops cut the bento and steps specimens mid-headline. */
    .col > .spec { aspect-ratio: 16 / 10; padding: 0; border: 0; border-radius: 12px; }
    .col h3 { display: flex; align-items: baseline; justify-content: space-between; font-size: 18px; font-weight: 600; letter-spacing: -0.02em; }
    .col h3 button { font-size: 12px; font-weight: 500; letter-spacing: 0; color: var(--color-fg3); transition: color 160ms; }
