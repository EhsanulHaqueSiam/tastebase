---
import Footer from "../components/Footer.tsx";
import Gallery from "../components/Gallery.tsx";
import Hero from "../components/Hero.tsx";
import PlanDemo from "../components/PlanDemo.tsx";
import Setup from "../components/Setup.tsx";
import TouchIt from "../components/TouchIt.tsx";
import Base from "../layouts/Base.astro";
import { kinds } from "../../../src/registry/schema.ts";
import { formatPlan } from "../../../src/format.ts";
import { plan } from "../../../src/engine.ts";
import { aesthetics, libraries, lookChip, planJson, shelfLib } from "../lib/server.ts";

// Prerendered at build time: no Worker CPU per visit. Live stats load in islands from /api/stats.
export const prerender = true;

const BRIEFS = [
  "iOS-feel habit tracker with a bottom sheet and animated stats",
  "dev-tool landing page like Resend with a shader hero",
  "playful onboarding flow with confetti-level delight",
  "dense analytics dashboard with charts and a command menu",
];
const libs = libraries;
const commands = ["Set up tastebase from https://tastebase.ehsanulsiam.workers.dev/llms.txt"];
---

<Base home>
  <Hero client:load counts={{ libs: libs.length, looks: aesthetics.length, kinds: kinds.length }} />
  <PlanDemo client:visible initial={planJson(libs, BRIEFS[0]!)} briefs={BRIEFS} />
  <TouchIt client:visible />
  <Gallery client:visible libs={libs.map(shelfLib)} looks={aesthetics.map(lookChip)} />
  <Setup client:visible commands={commands} sample={formatPlan(plan(libs, aesthetics, BRIEFS[0]!))} />
  <Footer client:visible />
</Base>
