---
import Gallery from "../components/Gallery.tsx";
import Hero from "../components/Hero.tsx";
import HomeFeatures from "../components/HomeFeatures.tsx";
import { ListingCard } from "../components/ListingCard.tsx";
import PlanDemo from "../components/PlanDemo.tsx";
import Setup from "../components/Setup.tsx";
import TouchIt from "../components/TouchIt.tsx";
import Base from "../layouts/Base.astro";
import { formatPlan } from "../../../src/format.ts";
import { plan } from "../../../src/engine.ts";
import { aesthetics, libraries, lookChip, planJson, shelfLib } from "../lib/server.ts";
import { comparisons, roundups } from "../lib/articles.ts";
import { categories } from "../lib/categories.ts";
import { listedResources, recentListings } from "../lib/listings.ts";

// Prerendered at build time: no Worker CPU per visit. Live stats load in islands from /api/stats.
export const prerender = true;

const BRIEFS = [
  "iOS-feel habit tracker with a bottom sheet and animated stats",
  "dev-tool landing page like Resend with a shader hero",
  "playful onboarding flow with confetti-level delight",
  "dense analytics dashboard with charts and a command menu",
];
const libs = libraries;
const sample = libraries.find((l) => l.id === "vaul") ?? libraries[0]!;
const recent = recentListings(10);
const commands = ["Set up tastebase from https://tastebase.ehsanulsiam.workers.dev/llms.txt"];
---

<Base>
  <Hero client:load counts={{ libs: libs.length, resources: listedResources.length, looks: aesthetics.length }} />
  {/* First visits only: plain HTML, so the survey's code loads only when Start opens it in the account sheet. */}
  <div id="taste" hidden class="mx-auto w-full max-w-[632px] px-4">
    <div class="flex items-center gap-2 rounded-xl bg-s2 py-2 pr-2 pl-3.5 text-[13px] shadow-[inset_0_0_0_1px_var(--color-line2)]">
      <p class="min-w-0 flex-1 text-fg2"><b class="font-semibold text-fg">Find your taste in 30 seconds.</b> <span class="max-sm:hidden">Swipe a few looks; your agent learns from it.</span></p>
      <button type="button" data-start class="press h-8 rounded-lg bg-s3 px-3 text-[13px] font-semibold text-fg shadow-[inset_0_0_0_1px_var(--color-line2)]">Start</button>
      <button type="button" aria-label="Dismiss" class="press grid size-8 place-items-center rounded-lg text-fg3 hover:text-fg">
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
  {/* rerun: the router skips inline scripts it has run once, and a navigation back to Home brings a new banner. */}
  <script is:inline data-astro-rerun>
    (() => {
      const el = document.getElementById("taste");
      let seen = "";
      try { seen = localStorage.getItem("tastebase:survey") ?? ""; } catch {}
      if (!el || seen) return el?.remove();
      el.hidden = false;
      el.addEventListener("click", (e) => {
        const b = e.target.closest("button");
        if (b && "start" in b.dataset) dispatchEvent(new Event("tb:survey")); // AccountButton opens the survey
        else if (b) { try { localStorage.setItem("tastebase:survey", "dismissed"); } catch {} el.remove(); }
      });
    })();
  </script>
  <HomeFeatures client:visible categories={categories.length} libraries={Math.floor(libs.length / 10) * 10} articles={roundups.length + comparisons.length} sample={{ name: sample.name, tagline: sample.tagline }} />
  <section aria-labelledby="recent" class="mx-auto w-full max-w-[1250px] px-4 pb-20 md:px-8">
    <h2 id="recent" class="text-[24px] leading-[1.05] font-medium tracking-[-0.03em] sm:text-[30px] md:text-[36px]">Recently added</h2>
    <ul class="mt-8 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-3 md:gap-5 lg:grid-cols-5">
      {recent.map((item) => <li class="flex"><div class="w-full"><ListingCard item={item} compact /></div></li>)}
    </ul>
  </section>
  <PlanDemo client:visible initial={planJson(libs, BRIEFS[0]!)} briefs={BRIEFS} />
  <TouchIt client:visible />
  <Gallery client:visible libs={libs.map(shelfLib)} looks={aesthetics.map(lookChip)} />
  <Setup client:visible commands={commands} sample={formatPlan(plan(libs, aesthetics, BRIEFS[0]!))} />
</Base>
