---
// Not found: served for any path no page or route matches. Prerendered; the Worker hands it out with a 404.
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base title="Page not found · tastebase" description="That page is not on tastebase." noindex>
  <div class="mx-auto flex min-h-[70svh] max-w-md flex-col items-center justify-center px-4 pt-14 text-center">
    <p class="font-mono text-[12px] font-medium tracking-[0.12em] text-fg3 uppercase">404</p>
    <h1 class="mt-3 text-[clamp(30px,4vw,40px)] leading-tight font-semibold tracking-[-0.035em]">Page not found</h1>
    <p class="mt-2 text-[15px] text-fg2">It may have moved, or the library it was about left the registry.</p>
    <div class="mt-7 flex flex-wrap justify-center gap-2">
      <a href="/" class="press inline-flex h-10 items-center rounded-xl bg-fg px-4 text-[14px] font-semibold text-bg hover:opacity-90">Back home</a>
      <button type="button" data-open-search class="press inline-flex h-10 items-center gap-2 rounded-xl px-4 text-[14px] font-semibold shadow-[inset_0_0_0_1px_var(--color-line2)] hover:bg-s2">Search <span class="kbd">⌘K</span></button>
    </div>
  </div>
</Base>
