---
// /terms: the plain terms for using the site, the API and the MCP server. Prerendered.
import Base from "../layouts/Base.astro";
import { REPO } from "../lib/site.ts";

export const prerender = true;

const sections = [
  ["Using tastebase", "The site, the JSON API, the MCP server and the CLI are free to use. Please keep automated use reasonable: the service runs on a small free allowance, and heavy scraping slows it down for everyone."],
  ["What we list", "Every library and resource belongs to its own authors and is under its own licence. We describe them as carefully as we can and check entries against npm and GitHub, but read a project's own licence and docs before you depend on it. Recommendations are our judgment, not a guarantee."],
  ["Sponsored placements", "Sponsors appear on the site, always marked “Sponsored”, with links marked rel=sponsored. A sponsorship never changes what the engine picks, and agent answers never carry sponsors."],
  ["Accounts", "Signing in is optional. When you sign in, we keep the name, avatar and email your sign-in provider shares, plus the libraries you save and the folders you make. A folder is private until you share its link. Signing out ends the session on that device."],
  ["What we count", "We count page views and how many browsers visited in the last 30 days, with no cookie and no identifier: a browser notes in its own storage when it was last counted. We count which libraries agents ask about, by library only, never the question or who asked."],
  ["No warranty", "tastebase is provided as is, without any warranty. We are not liable for losses from using it or the projects it lists."],
  ["Changes and contact", "These terms may change as the service does; the current version is always on this page. Questions or a correction: use the feedback form or open an issue on GitHub."],
] as const;
---

<Base title="Terms · tastebase" description="The plain terms for using tastebase: the site, the API, the MCP server and accounts.">
  <div class="mx-auto max-w-2xl px-4 pt-24 pb-24">
    <h1 class="enter text-[clamp(28px,3.6vw,40px)] leading-tight font-semibold tracking-[-0.035em]">Terms</h1>
    <p class="enter mt-3 text-[15px] text-fg2">Short and plain. By using tastebase you agree to these.</p>
    <div class="mt-10 grid gap-8">
      {
        sections.map(([t, d]) => (
          <section>
            <h2 class="text-[16px] font-semibold tracking-[-0.01em]">{t}</h2>
            <p class="mt-1.5 text-[14.5px] leading-[1.6] text-fg2">{d}</p>
          </section>
        ))
      }
    </div>
    <p class="mt-12 text-[13.5px] text-fg3">
      <a href="/feedback" class="text-fg2 underline underline-offset-4 hover:text-fg">Feedback</a> · <a href={`${REPO}/issues`} target="_blank" rel="noreferrer" class="text-fg2 underline underline-offset-4 hover:text-fg">GitHub issues</a>
    </p>
  </div>
</Base>
