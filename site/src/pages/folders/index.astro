---
// /folders moved into the dashboard. A static page that sends old links there (a meta refresh keeps the #folders hash;
// no Base layout, so no share card or Markdown copy is written for it).
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0;url=/account#folders" />
    <link rel="canonical" href="/account" />
    <title>Folders · tastebase</title>
  </head>
  <body style="background:#000;color:#f5f5f5;font-family:system-ui,sans-serif">
    <h1 style="font-size:16px;font-weight:500"><a href="/account#folders" style="color:inherit">Your folders are in your account</a></h1>
  </body>
</html>
