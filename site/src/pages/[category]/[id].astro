---
// A resource's page (/fonts/fontshare): the shared detail layout with its cost line and, when it has one, its MCP.
import Detail from "../../components/Detail.astro";
import FromDesigneer from "../../components/FromDesigneer.astro";
import { PickToggle } from "../../components/EditorPick.tsx";
import Base from "../../layouts/Base.astro";
import { categories } from "../../lib/categories.ts";
import { listedResources, relatedTo, resourceListing } from "../../lib/listings.ts";

export const prerender = true;
export const getStaticPaths = () => listedResources.map(({ r, category }) => ({ params: { category, id: r.id }, props: { r, category } }));

const { r, category } = Astro.props;
const item = { ...resourceListing(r, category), description: r.goodFor };
const label = categories.find((c) => c.slug === category)!.label;
---

<Base title={`${r.name} · tastebase`} description={r.goodFor} shot={item.image} crumbs={[[label, `/${category}`], [r.name, item.href]]}>
  <Detail item={item} related={relatedTo(item)}>
    <div slot="meta" class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-[13.5px] text-fg3">
      <p>{r.cost}{r.mcp && <> · <a href={r.mcp.url} target="_blank" rel="noopener" class="text-fg2 underline decoration-fg3 underline-offset-4 hover:decoration-fg hover:text-fg">{r.mcp.name}</a>{r.mcp.needsPaidPlan ? " (paid plan)" : " (free)"}</>}</p>
      <PickToggle client:idle id={r.id} />
    </div>
    <FromDesigneer slot="meta" id={r.id} caveat={r.caveat} />
  </Detail>
</Base>
