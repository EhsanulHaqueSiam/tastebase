---
// /tools, /mockups, /icons, /fonts, /colours, /illustrations, /ui, /inspiration: one category's libraries and resources.
import CategoryGrid from "../../components/CategoryGrid.tsx";
import Base from "../../layouts/Base.astro";
import { categories } from "../../lib/categories.ts";
import { listingsIn } from "../../lib/listings.ts";

export const prerender = true;
export const getStaticPaths = () => categories.map((c) => ({ params: { category: c.slug }, props: { c } }));

const { c } = Astro.props;
const items = listingsIn(c.slug);
---

<Base title={`${c.label} · tastebase`} description={c.blurb}>
  <div class="mx-auto max-w-[1440px] px-4 pt-20 lg:px-6">
    <nav aria-label="Categories" class="-mx-4 mb-6 flex gap-1 overflow-x-auto px-4 [scrollbar-width:none] lg:mx-0 lg:px-0">
      {
        categories.map((x) => (
          <a
            href={`/${x.slug}`}
            aria-current={x.slug === c.slug ? "page" : undefined}
            class={`press flex h-8 flex-none items-center rounded-lg px-3 text-[13.5px] whitespace-nowrap transition-colors ${x.slug === c.slug ? "bg-s2 text-fg shadow-[inset_0_0_0_1px_var(--color-line2)]" : "text-fg2 hover:text-fg"}`}
          >
            {x.label}
          </a>
        ))
      }
    </nav>
    <h1 class="enter text-[clamp(32px,4vw,44px)] leading-none font-semibold tracking-[-0.04em]">{c.label}</h1>
    <p class="enter mt-3 max-w-3xl text-[15px] text-fg2 sm:text-[16px]">{c.blurb}</p>
    <CategoryGrid client:load items={items} label={c.label} />
  </div>
</Base>
