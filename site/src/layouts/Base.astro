---
// Page shell: head, header, view transitions, and the islands that persist across pages (palette + toasts).
import { ClientRouter } from "astro:transitions";
import BackToTop from "../components/BackToTop.tsx";
import Dock from "../components/Dock.tsx";
import { GithubMark } from "../components/GithubMark.tsx";
import HeaderSearch from "../components/HeaderSearch.tsx";
import Palette from "../components/Palette.tsx";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const { title = "tastebase", description = "Hand-picked UI libraries, with notes your coding agent uses to pick the right one.", home = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&display=swap" />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-40 flex h-14 items-center gap-6 px-5" transition:persist="header">
      <a href="/" class="group flex items-center gap-2 font-semibold tracking-[-0.02em]">
        <svg viewBox="0 0 100 100" class="size-[18px]" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round"><path d="M44 18V64Q44 80 60 80H68" /><path d="M28 40H64" /></g>
          <circle cx="76" cy="24" r="7.5" class="origin-center fill-blue transition-transform duration-200 ease-[var(--ease-out)] [transform-box:fill-box] group-hover:scale-125" />
        </svg>
        tastebase
      </a>
      <!-- Phones keep only the current section's link. The header persists, so the script below re-marks it. -->
      <nav class="relative -ml-2.5 flex text-fg2" data-nav>
        <span data-nav-pill aria-hidden="true"></span>
        {["/browse", "/atlas", "/looks"].map((href) => (
          <a href={href} data-section aria-current={path.startsWith(href) ? "page" : undefined} class="relative rounded-lg px-2.5 py-1 transition-colors hover:text-fg aria-[current=page]:text-fg max-sm:not-aria-[current=page]:hidden">
            {href[1]!.toUpperCase() + href.slice(2)}
          </a>
        ))}
        <a href="/#plan" class="relative rounded-lg px-2.5 py-1 transition-colors hover:text-fg max-sm:hidden">Plan</a>
        <a href="/#mcp" class="relative rounded-lg px-2.5 py-1 transition-colors hover:text-fg max-sm:hidden">MCP</a>
      </nav>
      <span class="flex-1"></span>
      <HeaderSearch client:idle />
      <a href="https://github.com/EhsanulHaqueSiam/tastebase" aria-label="GitHub" class="press text-fg2 hover:text-fg"><GithubMark size={18} /></a>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <script>
      // Hover pill: appears under the first link pointed at, then glides between links; mouse only.
      const nav = document.querySelector<HTMLElement>("[data-nav]")!;
      const pill = nav.querySelector<HTMLElement>("[data-nav-pill]")!;
      nav.addEventListener("pointerover", (e) => {
        const a = (e.target as Element).closest<HTMLElement>("a");
        if (!a || e.pointerType !== "mouse") return;
        const first = pill.style.opacity !== "1";
        pill.toggleAttribute("data-instant", first);
        Object.assign(pill.style, { transform: `translate(${a.offsetLeft}px, ${a.offsetTop}px)`, width: `${a.offsetWidth}px`, height: `${a.offsetHeight}px`, opacity: "1" });
      });
      nav.addEventListener("pointerleave", () => (pill.style.opacity = "0"));
      document.addEventListener("astro:page-load", () =>
        document.querySelectorAll<HTMLAnchorElement>("[data-section]").forEach((a) =>
          location.pathname.startsWith(a.pathname) ? a.setAttribute("aria-current", "page") : a.removeAttribute("aria-current"),
        ),
      );
    </script>
    <Palette client:idle transition:persist="palette" />
    {home ? <Dock client:idle /> : <BackToTop client:idle />}
  </body>
</html>
