---
// Page shell: head, header, view transitions, and the islands that persist across pages (palette + toasts).
import { ClientRouter } from "astro:transitions";
import { Search } from "lucide-react";
import Dock from "../components/Dock.tsx";
import { GithubMark } from "../components/GithubMark.tsx";
import Palette from "../components/Palette.tsx";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}
const { title = "tastebase", description = "Hand-picked UI libraries, with notes your coding agent uses to pick the right one.", home = false } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Instrument+Serif:ital@1&display=swap" />
    <ClientRouter />
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-40 flex h-14 items-center gap-6 px-5" transition:persist="header">
      <a href="/" class="group flex items-center gap-2 font-semibold tracking-[-0.02em]">
        <svg viewBox="0 0 100 100" class="size-[18px]" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round"><path d="M44 18V64Q44 80 60 80H68" /><path d="M28 40H64" /></g>
          <circle cx="76" cy="24" r="7.5" class="origin-center fill-blue transition-transform duration-200 ease-[var(--ease-out)] [transform-box:fill-box] group-hover:scale-125" />
        </svg>
        tastebase
      </a>
      <nav class="hidden gap-5 text-fg2 sm:flex">
        <a href="/browse" class:list={["transition-colors hover:text-fg", path.startsWith("/browse") && "text-fg"]}>Browse</a>
        <a href="/atlas" class:list={["transition-colors hover:text-fg", path.startsWith("/atlas") && "text-fg"]}>Atlas</a>
        <a href="/#plan" class="transition-colors hover:text-fg">Plan</a>
        <a href="/#mcp" class="transition-colors hover:text-fg">MCP</a>
      </nav>
      <span class="flex-1"></span>
      <button data-open-search aria-label="Search" class="press flex items-center gap-2 rounded-lg bg-white/5 p-2 text-[13px] text-fg2 shadow-[inset_0_0_0_1px_var(--color-line)] backdrop-blur-md hover:text-fg sm:py-1.5 sm:pr-1.5 sm:pl-3">
        <Search size={14} /> <span class="hidden sm:inline">Search</span> <span class="kbd hidden sm:inline">⌘K</span>
      </button>
      <a href="https://github.com/EhsanulHaqueSiam/tastebase" aria-label="GitHub" class="press text-fg2 hover:text-fg"><GithubMark size={18} /></a>
    </header>

    <main transition:animate="fade">
      <slot />
    </main>

    <Palette client:idle transition:persist="palette" />
    {home && <Dock client:idle />}
  </body>
</html>
