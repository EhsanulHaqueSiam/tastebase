---
// Page shell: head (SEO, Open Graph, JSON-LD), header, view transitions, and the islands that persist across pages.
import { ClientRouter } from "astro:transitions";
import AccountButton from "../components/AccountButton.tsx";
import BackToTop from "../components/BackToTop.tsx";
import { GithubMark } from "../components/GithubMark.tsx";
import HeaderSearch from "../components/HeaderSearch.tsx";
import Palette from "../components/Palette.tsx";
import Rail from "../components/Rail.tsx";
import TabBar from "../components/TabBar.tsx";
import ThemeToggle from "../components/ThemeToggle.tsx";
import SoundToggle from "../components/SoundToggle.tsx";
import SessionToasts from "../components/SessionToasts.tsx";
import SiteFooter from "../components/SiteFooter.astro";
import { ProgressiveBlur } from "../components/ui/progressive-blur.tsx";
import { jsonLd } from "../lib/articles.ts";
import { isCurrent, sections } from "../lib/nav.ts";
import { canonicalPath, markdownPath, ogImagePath, ORIGIN, REPO } from "../lib/site.ts";
import "../styles.css";
import type { TransitionDirectionalAnimations } from "astro";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** A screenshot (/shots/<id>.webp) for this page's OG card; site/build.ts draws it beside the title. */
  shot?: string;
  /** Breadcrumb trail after Home, as [name, path] pairs: becomes BreadcrumbList JSON-LD. */
  crumbs?: [string, string][];
}
const { title = "tastebase", description = "Hand-picked UI libraries, with notes your coding agent uses to pick the right one.", ogType = "website", noindex = false, shot, crumbs } = Astro.props;
const path = Astro.url.pathname;
// The page change. Astro's fade is 180ms ease-in-out-quart both ways, which keeps the new page nearly invisible for its
// first ~60ms on top of the swap itself; here the old page leaves fast and the new one eases in from its first frame.
const swap = { old: { name: "astroFadeOut", duration: "90ms", easing: "ease-in", fillMode: "both" }, new: { name: "astroFadeIn", duration: "160ms", easing: "cubic-bezier(0.23, 1, 0.32, 1)", fillMode: "both" } };
const pageSwap: TransitionDirectionalAnimations = { forwards: swap, backwards: swap };
const current = sections.find((s) => isCurrent(s, path));
const canonical = `${ORIGIN}${canonicalPath(path)}`;
// Only prerendered pages get their own card and Markdown copy (site/build.ts writes them from the built HTML).
const own = Astro.isPrerendered && !noindex;
const ogImage = `${ORIGIN}${ogImagePath(own ? canonicalPath(path) : "/")}`;
const graph = [
  {
    "@type": "WebSite",
    "@id": `${ORIGIN}/#website`,
    url: `${ORIGIN}/`,
    name: "tastebase",
    description: "Hand-picked UI libraries, with notes your coding agent uses to pick the right one.",
    potentialAction: { "@type": "SearchAction", target: { "@type": "EntryPoint", urlTemplate: `${ORIGIN}/?q={search_term_string}` }, "query-input": "required name=search_term_string" },
  },
  { "@type": "Organization", "@id": `${ORIGIN}/#organization`, name: "tastebase", url: `${ORIGIN}/`, logo: `${ORIGIN}/apple-touch-icon.png`, sameAs: [REPO] },
  {
    "@type": "ItemList",
    "@id": `${ORIGIN}/#sitenavigation`,
    name: "Site navigation",
    itemListElement: [...sections.filter((s) => !s.href.includes("#")), { href: "/about", label: "About" }].map((s, i) => ({ "@type": "SiteNavigationElement", position: i + 1, name: s.label, url: `${ORIGIN}${s.href}` })),
  },
  ...(crumbs ? [{ "@type": "BreadcrumbList", itemListElement: [["tastebase", "/"], ...crumbs].map(([name, p], i) => ({ "@type": "ListItem", position: i + 1, name, item: `${ORIGIN}${p}` })) }] : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="tb-build" content={__BUILD__} />
    <!-- Theme, the hidden rail (⌘B) and embed mode (framed by our own /browse sheet, DetailSheet.tsx) before first
         paint, and again after each client navigation (the router replaces <html>'s attributes). Also marks listing screenshots that fail to load, so their fallback shows (ListingCard.tsx);
         the listener sits in the head so it catches errors from before any island hydrates. -->
    <script is:inline>
      (() => {
        const apply = () => {
          let t = "dark", rail = false;
          try { t = localStorage.getItem("tb-theme") === "light" ? "light" : "dark"; rail = localStorage.getItem("tb-rail") === "hidden"; } catch {}
          document.documentElement.dataset.theme = t;
          document.documentElement.toggleAttribute("data-rail-hidden", rail);
          let framed = false;
          try { framed = window !== top && top.location.origin === location.origin; } catch {} // another origin: not ours
          document.documentElement.toggleAttribute("data-embed", framed);
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "light" ? "#ffffff" : "#000000");
        };
        apply();
        document.addEventListener("astro:after-swap", apply);
        // Back and Forward into or out of /browse's sheet (DetailSheet.tsx) belong to the sheet. Registered here, before
        // the router's own listener, so the router never re-renders /browse or loads the full page for them.
        addEventListener("popstate", (e) => {
          // Where Back or Forward should land: the router saves the scroll again once it has restored it, which a page
          // still too short to reach it (/browse before its cards mount, Directory.tsx) cuts short.
          if (e.state) window.tbBack = { index: e.state.index, y: e.state.scrollY };
          const into = e.state && e.state.sheet;
          if (!document.documentElement.hasAttribute("data-sheet") && !(into && document.querySelector("[data-sheet-host]") && matchMedia("(min-width: 1024px)").matches)) return;
          e.stopImmediatePropagation();
          dispatchEvent(new CustomEvent("tb:sheet", { detail: into || null }));
        });
        // Back to a scrolled /browse: hold the grid tall enough to restore into before its cards mount, so the reader
        // sees the grid filling in, never the footer of the short prerendered page. Directory.tsx drops the hold.
        document.addEventListener("astro:before-swap", (e) => {
          const b = window.tbBack;
          if (b && b.index === history.state?.index && b.y > innerHeight && e.newDocument.querySelector("[data-sheet-host]")) e.newDocument.documentElement.style.setProperty("--tb-hold", `${b.y + innerHeight}px`);
        });
        addEventListener("error", (e) => { const t = e.target; if (t instanceof HTMLImageElement && "fallback" in t.dataset) t.dataset.failed = ""; }, true);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {own && <link rel="alternate" type="text/markdown" href={markdownPath(canonicalPath(path))} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="tastebase" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} data-shot={own ? shot : undefined} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={jsonLd({ "@context": "https://schema.org", "@graph": graph })} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/_fonts/general-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/_fonts/general-sans-600.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="max-lg:pb-[calc(60px+env(safe-area-inset-bottom))]">
    <!-- Desktop: a 56px icon rail (Rail.tsx), a top bar with the section name and search, and the page inside a rounded
         inset frame. Phones: the top bar and a bottom tab bar (TabBar.tsx). All three persist across navigations. -->
    {/* persist-props: navigations do not re-render persisted islands, so one clicked before it hydrated is not updated
        early (React #424). Rail follows the path itself (usePath); its prop is only the first value. */}
    <Rail client:load path={path} transition:persist="rail" transition:persist-props />

    <header data-shell="header" class="fixed inset-x-0 top-0 z-40 flex h-14 items-center gap-4 px-5 lg:left-14 lg:pl-2.5" transition:persist="header">
      <!-- Phones: content scrolls under the header, so it fades out through a progressive blur (Motion Primitives). -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-20 bg-gradient-to-b from-bg/80 to-transparent lg:hidden"><ProgressiveBlur direction="top" blurLayers={6} blurIntensity={0.6} className="h-full" /></div>
      <button type="button" data-toggle-nav aria-label="Show sidebar" title="Show sidebar (⌘B)" class="press hidden size-9 place-items-center rounded-[10px] text-fg2 hover:text-fg lg:[[data-rail-hidden]_&]:grid">
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" /><path d="M9 3v18M14 9l3 3-3 3" /></svg>
      </button>
      <a href="/" class="group flex items-center gap-2 font-semibold tracking-[-0.02em] lg:hidden">
        <svg viewBox="0 0 100 100" class="size-[18px]" aria-hidden="true">
          <g fill="none" stroke="currentColor" stroke-width="13" stroke-linecap="round"><path d="M44 18V64Q44 80 60 80H68" /><path d="M28 40H64" /></g>
          <circle cx="76" cy="24" r="7.5" class="origin-center fill-blue [transform-box:fill-box]" />
        </svg>
        tastebase
      </a>
      <span class="hidden text-[13.5px] text-fg2 lg:inline">tastebase <span class="mx-1.5 text-fg3">/</span> <b class="font-medium text-fg" data-crumb>{current?.label ?? ""}</b></span>
      <span class="flex-1"></span>
      {/* client:load: the header persists across navigations, and an idle island moved mid-hydration by a fast click
          broke React (#424). These four are small. */}
      <HeaderSearch client:load />
      <SoundToggle client:load className="size-9 rounded-[10px]" />
      <ThemeToggle client:load className="size-9 rounded-[10px]" />
      <AccountButton client:load />
      <a href="https://github.com/EhsanulHaqueSiam/tastebase" aria-label="GitHub" class="press text-fg2 hover:text-fg lg:hidden"><GithubMark size={18} /></a>
    </header>

    <!-- The inset frame: one fixed ring whose huge spread paints the gutters black, so pages keep scrolling the window
         and need no layout of their own. Painted once; scrolling never repaints it. -->
    <div aria-hidden="true" data-shell="frame" class="pointer-events-none fixed top-14 right-2 bottom-2 left-16 z-30 hidden rounded-2xl shadow-[0_0_0_100vmax_var(--color-bg),inset_0_0_0_1px_var(--color-line2)] lg:block"></div>

    <main transition:animate={pageSwap} data-shell="main" class="lg:pr-2 lg:pl-16">
      <slot />
      <SiteFooter />
    </main>

    <script>
      // One page view per page shown, client navigations included (lib/views.ts), and the sound cues if switched on.
      import { countView } from "../lib/views.ts";
      import { startSound } from "../lib/sound.ts";
      import { toggleNav } from "../lib/rail.ts";
      import { startPrefetch, warm } from "../lib/prefetch.ts";
      document.addEventListener("astro:page-load", countView);
      // A view transition is aborted when the viewport resizes mid-navigation (a phone's URL bar hiding): the page still
      // swaps, only the animation is skipped, so the rejection the browser raises is noise, not an error.
      // React #424: a navigation removed an island while it was still hydrating (Astro unmounts it; React reports the
      // early update and falls back to client rendering a root that is going away). Only reachable with clicks tens of
      // milliseconds apart; nothing on screen breaks, so it is not reported as an error.
      // Only while a navigation swaps the page (and a second after), so a #424 at any other time still shows. The second
      // pattern is the same error unminified, under pnpm dev.
      let swapping = 0;
      document.addEventListener("astro:before-swap", () => (swapping = Date.now()));
      addEventListener("error", (e) => Date.now() - swapping < 1000 && /Minified React error #424\b|received an early update, before anything was able hydrate/.test(e.message) && e.preventDefault());
      addEventListener("unhandledrejection", (e) => {
        if (e.reason instanceof DOMException && e.reason.name === "InvalidStateError" && /transition was aborted/i.test(e.reason.message)) e.preventDefault();
      });
      // A deploy deletes the previous build's scripts, so an island or lazy part of a page opened before it fails to load
      // (Chrome, Safari and Firefox each word it differently). Reload into the new build, once per build, so a flaky
      // network cannot loop.
      const reloadStale = (err: unknown) => {
        if (!(err instanceof Error) || !navigator.onLine || !/dynamically imported module|Importing a module script failed/i.test(err.message)) return false;
        try {
          if (sessionStorage.getItem("tb-reload") === __BUILD__) return false;
          sessionStorage.setItem("tb-reload", __BUILD__);
        } catch {
          return false;
        }
        location.reload();
        return true;
      };
      document.addEventListener("astro:hydration-error", (e) => reloadStale((e as CustomEvent<{ error: unknown }>).detail.error) && e.preventDefault());
      addEventListener("unhandledrejection", (e) => reloadStale(e.reason) && e.preventDefault());
      addEventListener("error", (e) => reloadStale(e.error) && e.preventDefault());
      startSound();
      startPrefetch();
      // Screenshots marked data-late (ListingCard's `late`) wait for the page's load, so on a slow phone they do not
      // share bandwidth with the page's largest paint; after a client navigation the page is already loaded.
      const late = () => document.querySelectorAll<HTMLImageElement>("img[data-late]").forEach((i) => ((i.src = i.dataset.late!), i.removeAttribute("data-late")));
      addEventListener("load", late, { once: true });
      document.addEventListener("astro:page-load", () => document.readyState === "complete" && late());
      // Phones have no hover to prefetch on: once the first page has loaded, and after each navigation, warm the tab
      // bar's pages so a tab switch swaps at once.
      const idle = (fn: () => void) => ("requestIdleCallback" in window ? requestIdleCallback(fn) : setTimeout(fn, 200));
      const tabs = () => matchMedia("(max-width: 1023.98px)").matches && document.querySelectorAll<HTMLAnchorElement>('nav[data-shell="tabbar"] a[href^="/"]').forEach((a) => warm(a.href, true));
      addEventListener("load", () => (idle(tabs), document.addEventListener("astro:page-load", () => idle(tabs))), { once: true });
      // The header's "Show sidebar" button, there only while the rail is hidden. The header persists, so one listener.
      document.addEventListener("click", (e) => (e.target as Element).closest?.("[data-toggle-nav]") && toggleNav());
    </script>
    <script>
      // Sliding pills for segmented controls (lib/seg.ts) that Astro renders. Controls inside islands render their own
      // (Seg.tsx): adding one here before React hydrates would make the DOM differ from what React rendered.
      import { trackSeg } from "../lib/seg.ts";
      const untrack: (() => void)[] = [];
      document.addEventListener("astro:before-swap", () => untrack.splice(0).forEach((stop) => stop()));
      document.addEventListener("astro:page-load", () =>
        document.querySelectorAll<HTMLElement>(".seg:not([data-pill])").forEach((seg) => {
          if (seg.closest("astro-island")) return;
          const pill = Object.assign(document.createElement("span"), { className: "t-tabs-pill" });
          pill.setAttribute("aria-hidden", "true");
          seg.prepend(pill);
          untrack.push(trackSeg(seg, pill));
        }),
      );
    </script>
    <script>
      // WebMCP: browsers with an in-page agent (navigator.modelContext) get tastebase's picker as a tool. Registered once;
      // the script is a module, so client navigations don't run it again.
      type Tool = { name: string; description: string; inputSchema: object; execute: (args: { need?: string }) => Promise<unknown> };
      const mc = (navigator as Navigator & { modelContext?: { registerTool?: (tool: Tool) => void } }).modelContext;
      mc?.registerTool?.({
        name: "search_tastebase",
        description: "Find the best UI libraries for one job (a toast, a bottom sheet, a chart, a shader hero) from tastebase's curated registry, with why and the install command.",
        inputSchema: { type: "object", properties: { need: { type: "string", description: "The job, in plain words: 'toast', 'iOS-like bottom sheet', 'Vue data table'." } }, required: ["need"] },
        async execute({ need = "" }) {
          const res = await fetch(`/api/pick?q=${encodeURIComponent(need)}`);
          if (!res.ok) return { content: [{ type: "text", text: `tastebase could not answer (${res.status}).` }], isError: true };
          const picks: { lib: { id: string; name: string; tagline: string; install: string }; why: string }[] = await res.json();
          const text = picks.length ? picks.map((p) => `${p.lib.name}: ${p.why}. ${p.lib.install}. ${location.origin}/browse/${p.lib.id}`).join("\n") : "Nothing in the registry fits that job.";
          return { content: [{ type: "text", text }] };
        },
      });
    </script>
    <Palette client:idle transition:persist="palette" transition:persist-props />
    <TabBar client:load transition:persist="tabbar" transition:persist-props />
    <BackToTop client:idle />
    <SessionToasts client:idle transition:persist="toasts" transition:persist-props />
  </body>
</html>
