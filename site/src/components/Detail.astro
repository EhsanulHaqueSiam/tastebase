---
// The detail page every listing shares, library or resource (after Design Index's tool page). Left, scrolling on its
// own: name with its price pills, the description (and the editor's pick reason, when it is one), Visit and Share, "Try these", then whatever the page adds (a
// library's notes). Right, desktop only: the live site (LiveSite.tsx). Phones get the screenshot instead of a frame.
// The left column contains its own overscroll: reaching its end must not carry on into the page and slide the footer up.
import type { Listing } from "../lib/categories.ts";
import { thumb } from "../lib/kinds.ts";
import { withUtm } from "../lib/utm.ts";
import { DetailActions, DetailPill } from "./DetailActions.tsx";
import TryThese from "./TryThese.tsx";
import { PickReason } from "./EditorPick.tsx";
import LiveSite from "./LiveSite.tsx";
import unframeable from "../lib/unframeable.json";
import fullshots from "../lib/fullshots.json";

interface Props {
  item: Listing;
  related: Listing[];
}
const { item, related } = Astro.props;
const pills = item.pricing === "freemium" ? (["free", "paid"] as const) : ([item.pricing] as const);
const frameable = !unframeable.includes(item.id);
const fullHeight = (fullshots as Record<string, number>)[item.id];
---

<div data-detail class="grid grid-cols-1 pt-14 lg:h-[calc(100svh-8px)] lg:grid-cols-2">
  <section class="enter min-w-0 px-4 pt-5 pb-44 [scrollbar-width:none] lg:overflow-y-auto lg:overscroll-y-contain lg:px-6 lg:pb-32">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-[26px] leading-tight font-semibold tracking-[-0.03em] md:text-[30px]" transition:name={`name-${item.id}`}>{item.name}</h1>
      {
        pills.map((p) => (
          <span class={`rounded-[10px] px-3 py-1 font-mono text-[11.5px] font-medium tracking-[0.06em] uppercase ${p === "free" ? "bg-green/12 text-green" : "bg-amber/12 text-amber"}`}>{p}</span>
        ))
      }
    </div>
    <p class="mt-3 max-w-[62ch] text-[16px] leading-[1.45] text-fg2 md:text-[17px]">{item.description}</p>
    <PickReason client:load id={item.id} />
    <slot name="meta" />
    <DetailActions client:load name={item.name} url={item.url} />

    <a href={withUtm(item.url, "detail-preview")} target="_blank" rel="noopener" class="mt-6 block overflow-hidden rounded-xl bg-s1 shadow-[0_0_0_1px_var(--color-line2)] lg:hidden">
      <span class="flex h-7 items-center gap-1.5 border-b border-line bg-s2 px-2.5" aria-hidden="true">
        <i class="size-2 rounded-full bg-[#ff5f57]"></i><i class="size-2 rounded-full bg-[#febc2e]"></i><i class="size-2 rounded-full bg-[#28c840]"></i>
        <span class="ml-1 truncate font-mono text-[10px] text-fg3">{item.url}</span>
      </span>
      {/* The phone layout's largest paint: fetched first, ahead of the islands' scripts. */}
      <img src={thumb(item.image)} alt={`${item.name} website`} width="1200" height="750" fetchpriority="high" class="aspect-[16/10] w-full object-cover object-top" />
    </a>

    {
      related.length > 0 && (
        <>
          <h2 class="mt-8 font-mono text-[11px] font-medium tracking-[0.12em] text-fg3 uppercase">Try these</h2>
          <TryThese client:visible related={related} />
        </>
      )
    }
    <slot />
  </section>

  <section class="hidden min-h-0 py-3 pr-3 lg:block">
    {/* Open the preview site's connection while our page loads, so its frame starts sooner (a body-ok link type). */}
    {frameable && !item.down && <link rel="preconnect" href={new URL(item.demo ?? item.url).origin} />}
    <LiveSite client:media="(min-width: 1024px)" id={item.id} name={item.name} url={item.demo ?? item.url} image={item.image} frameable={frameable} fullHeight={fullHeight} video={item.video} down={item.down} />
  </section>
</div>
<DetailPill client:load name={item.name} url={item.url} />
