---
// The shell the three form pages share (after Design Index's): title, a lede, a checked list, then the form.
import { Check } from "lucide-react";

interface Props {
  title: string;
  lede: string;
  listTitle: string;
  points: string[];
}
const { title, lede, listTitle, points } = Astro.props;
---

<div class="mx-auto w-full max-w-xl px-4 pt-24 pb-32">
  <h1 class="enter text-[clamp(32px,4.4vw,44px)] leading-none font-semibold tracking-[-0.035em]">{title}</h1>
  <p class="enter mt-3 text-[15.5px] text-fg2">{lede}</p>
  <slot name="before" />
  <h2 class="mt-8 font-mono text-[11px] font-medium tracking-[0.12em] text-fg3 uppercase">{listTitle}</h2>
  <ul class="mt-3 divide-y divide-line overflow-hidden rounded-xl bg-s1 shadow-[inset_0_0_0_1px_var(--color-line)]">
    {
      points.map((p) => (
        <li class="flex items-start gap-3 px-4 py-3.5">
          <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-green/15 text-green"><Check size={12} strokeWidth={3} /></span>
          <span class="text-[14px] text-fg2">{p}</span>
        </li>
      ))
    }
  </ul>
  <slot />
</div>
