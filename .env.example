# Copy to .env (gitignored). scripts/with-env.sh loads it for pnpm dev, plan, deploy and logs.

# Fine-grained GitHub token with "Public repositories (read-only)" and nothing else. Used by the stats cron.
# https://github.com/settings/personal-access-tokens/new
STATS_GITHUB_TOKEN=

# Alchemy profile holding your Cloudflare login (~/.alchemy/profiles/<name>). Omit to use "default".
# ALCHEMY_PROFILE=default

# Optional custom domain for stage prod; the zone must be on the same Cloudflare account.
# TASTEBASE_DOMAIN=
