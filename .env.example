# Copy to .env (gitignored). scripts/with-env.sh loads it for pnpm dev, plan, deploy and logs.

# Fine-grained GitHub token with "Public repositories (read-only)" and nothing else. Used by the stats cron.
# https://github.com/settings/personal-access-tokens/new
STATS_GITHUB_TOKEN=

# Alchemy profile holding your Cloudflare login (~/.alchemy/profiles/<name>). Omit to use "default".
# ALCHEMY_PROFILE=default

# GitHub sign-in (optional; without any provider the site runs signed out). One OAuth app serves every stage:
# github.com/settings/applications/4040800. BETTER_AUTH_SECRET signs sessions: `openssl rand -base64 32`.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
# BETTER_AUTH_SECRET=

# Google and X sign-in (optional, each on its own pair; needs BETTER_AUTH_SECRET too). How to make the OAuth apps and
# which redirect URIs to register: docs/operations/deploy.md "Sign-in providers".
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_X_ID=
# AUTH_X_SECRET=

# Optional custom domain for stage prod; the zone must be on the same Cloudflare account.
# TASTEBASE_DOMAIN=

# Forms (/submit, /feedback, /sponsor) email submissions to FORMS_TO from FORMS_FROM. The sender's domain needs Email
# Routing on this Cloudflare account; the first prod deploy makes Cloudflare send FORMS_TO a verification link.
# FORMS_TO=you@example.com
# FORMS_FROM=tastebase@your-routing-domain.com
