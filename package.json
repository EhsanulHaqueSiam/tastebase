{
  "name": "tastebase",
  "version": "0.1.0",
  "description": "Curated UI libraries with the metadata coding agents need to pick the right one. CLI and MCP server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tastebase": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings src/engine.test.ts src/trending.test.ts src/registry/registry.test.ts",
    "dev": "alchemy dev --profile siamdev",
    "deploy": "alchemy deploy --stage prod --profile siamdev",
    "plan": "alchemy plan --stage prod --profile siamdev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
