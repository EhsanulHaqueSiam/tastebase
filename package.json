{
  "name": "tastebase",
  "version": "0.1.0",
  "description": "Curated UI libraries with the metadata coding agents need to pick the right one. CLI and MCP server.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EhsanulHaqueSiam/tastebase.git"
  },
  "homepage": "https://tastebase.ehsanulsiam.workers.dev",
  "bin": {
    "tastebase": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "sh scripts/with-env.sh sh -c 'cd site && alchemy dev -c ../alchemy.run.ts'",
    "check": "pnpm typecheck && pnpm typecheck:site && pnpm test && pnpm eval mcp-tool-use skill usage --check && pnpm eval design --warn && pnpm build",
    "test": "node --test --experimental-strip-types --no-warnings \"src/**/*.test.ts\" \"evals/**/*.test.ts\"",
    "test:update": "node --test --test-update-snapshots --experimental-strip-types --no-warnings src/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:site": "pnpm --filter site run typecheck",
    "build": "tsdown",
    "eval": "node --experimental-strip-types --no-warnings evals/run.ts",
    "probe": "node --experimental-strip-types --no-warnings scripts/probe.ts",
    "plan": "sh scripts/with-env.sh alchemy plan --stage prod",
    "deploy": "sh scripts/with-env.sh alchemy deploy --stage prod",
    "logs": "sh scripts/with-env.sh alchemy logs --stage prod --tail",
    "destroy:dev": "sh scripts/with-env.sh alchemy destroy",
    "capture": "node --experimental-strip-types --no-warnings scripts/capture.ts",
    "sync:repos": "node --experimental-strip-types --no-warnings scripts/sync-repos.ts",
    "setup:worktree": "node --experimental-strip-types --no-warnings scripts/setup-worktree.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@alchemy.run/github": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/node": "^26.6.6",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
